# Dependencies and local tools
.local/
.venv/
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]
.pytest_cache/

# Build output and machine-specific Android settings
dist/
android/.gradle/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
*.log

# Private data and credentials
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.jks
*.keystore
keystore.properties
.env
.env.*
!.env.example

# Generated Android binaries stay out of source builds. The checked-in APK in
# releases/ is an intentional public download artifact.
*.apk
*.aab
!releases/
!releases/*.apk
!releases/*.sha256
